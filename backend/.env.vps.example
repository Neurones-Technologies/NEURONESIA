# Copier en backend/.env.vps (gitignored) si tes valeurs diffèrent des
# défauts. Ne jamais committer ce fichier une fois rempli.
#
# Voie normale : authentification par clé SSH, comme le Host "iavps" de
# ~/.ssh/config. Rien à renseigner ici si ta clé est ~/.ssh/id_ed25519 —
# vps_config.py la détecte automatiquement.
VPS_HOST=76.13.51.87
VPS_USER=root
VPS_REMOTE_DIR=/opt/neurones-ia
# VPS_KEY_FILE=/chemin/vers/ta/cle          # si ta clé n'est pas ~/.ssh/id_ed25519
# VPS_KEY_PASSPHRASE=                       # si ta clé est protégée par une passphrase
# VPS_PASS=                                 # repli déconseillé, uniquement si pas de clé
