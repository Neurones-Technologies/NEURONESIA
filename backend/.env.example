# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Odoo (peut être sur un serveur distant) ───────────────────────────────────
ODOO_URL=https://odoo.neurones-tech.com
ODOO_DB=neurones_prod
ODOO_USERNAME=admin
ODOO_PASSWORD=
ODOO_SYNC_INTERVAL_HOURS=2

# ── Chemins données ───────────────────────────────────────────────────────────
GED_PATH=../data/ged
TEMPLATES_PATH=../data/templates
UPLOADS_PATH=../data/uploads
CHROMADB_PATH=../data/chromadb
BM25_INDEX_PATH=../data/bm25_index
LOCAL_DB_PATH=../data/local_db/neurones.db

# ── RAG ───────────────────────────────────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=60
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=3000
MAX_HISTORY_TURNS=6

# ── Budget tokens ─────────────────────────────────────────────────────────────
TOKEN_BUDGET_MONTHLY_FCFA=130000
TOKEN_ALERT_THRESHOLD_PCT=80

# ── Cache Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
